{
  "version": 2,
  "builds": [
    { "src": "api/**/*.py", "use": "@vercel/python" }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.py"
    },
    {
      "src": "/og/match/(.*)",
      "dest": "/api/og_match.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}